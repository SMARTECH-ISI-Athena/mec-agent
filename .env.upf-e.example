PORTAL_BASE_URL=https://back-6gbricks.dedyn.io
AGENT_TOKEN=

# UPF-E telemetry role: reports the UPF-E -> UPF-CN and UPF-E -> EdgeDN legs.
# In the current UPF-E topology, both N9 and edge breakout are on eth0, so the
# agent uses filtered iptables counters to distinguish the two logical links.
N9_CIDR=172.32.1.0/24
N6_CIDR=172.32.1.0/24

# UPF-CN N9 address, used for UPF-E -> UPF-CN latency and filtered counters.
UPF_CN_N9_TARGET=172.32.0.134
UPF_E_N9_FILTER_CIDR=172.32.0.134/32

# EdgeDN subnet/target, used for UPF-E -> EdgeDN filtered counters and latency.
EDGE_DN_FILTER_CIDR=172.33.0.0/24
EDGE_DN_LATENCY_TARGET=172.33.0.100
